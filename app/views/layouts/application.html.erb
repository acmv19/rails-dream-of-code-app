<body>
  <div class="header">
    <nav class="navbar navbar-expand-lg d-flex justify-content-between align-items-end">
      <div class="d-flex align-items-end">
        <%= image_tag 'doc.png', alt: 'Dream of Code', height: '100' %>
        <ul class="navbar-nav ml-3">
          <li class='nav-item'>
            <%= link_to 'Home', root_path, class: 'nav-link' %>
          </li>

          <% if session[:user_id] %>
            <% user = User.find_by(id: session[:user_id]) %>
            <% if user %>
              <% if user.role == 'admin' %>
                <li class="nav-item"><%= link_to 'Dashboard', dashboard_path, class: 'nav-link' %></li>
                <li class="nav-item"><%= link_to 'New Course', new_course_path, class: 'nav-link' %></li>
                <li class="nav-item"><%= link_to 'New Trimester', new_trimester_path, class: 'nav-link' %></li>
                <li class="nav-item"><%= link_to 'Student Enrollments', enrollments_path, class: 'nav-link' %></li>
              <% elsif user.role == 'student' %>
                <li class="nav-item"><%= link_to 'My Courses', courses_path, class: 'nav-link' %></li>
                <li class="nav-item"><%= link_to 'New Submission', new_course_submission_path(@course || 1), class: 'nav-link' %></li>
              <% elsif user.role == 'mentor' %>
                <li class="nav-item"><%= link_to 'Submissions to Review', submissions_path, class: 'nav-link' %></li>
              <% end %>
            <% end %>
          <% end %>

          <% if session[:user_id] && user %>
            <li class='nav-item'>
              <span class="nav-link">Welcome, <%= user.username %>!</span>
            </li>
          <% end %>
        </ul>
      </div>

      <div class="login-logout">
        <% if session[:user_id] %>
          <%= button_to 'Logout', logout_path, method: :delete, class: 'logout-link nav-link', data: { confirm: 'Are you sure you want to log out?' } %>
        <% else %>
          <%= link_to 'Login', login_path, class: 'logout-link nav-link' %>
        <% end %>
      </div>
    </nav>
  </div>

  <div class='container main-container'>
    <%= yield %>
  </div>
</body>
