<h1>Edit Submission</h1>

<%= form_with(model: [@course, @submission], local: true) do |form| %>
  <div>
    <%= form.label :review_result, "Review Result" %><br>
    <%= form.select :review_result, options_for_select([["Aprobado", "aprobado"], ["Necesita corrección", "necesita correccion"]], @submission.review_result) %>
  </div>

  <div>
    <%= form.label :pull_request_url, "Pull Request URL" %><br>
    <%= form.text_field :pull_request_url, value: @submission.pull_request_url %>
  </div>

  <div>
    <%= form.submit "Update Submission" %>
  </div>
<% end %>

<%= link_to 'Back', course_submissions_path(@course) %>
